---
// 月別の最安運賃テーブル。データは scripts/fetch_fares.mjs がビルド前に取得した静的 JSON。
//
// このコンポーネントが守る約束:
//   1. ブラウザから API を叩かない。価格は静的HTMLに焼き込まれる（＝JS無効でもクローラーでも読める）。
//   2. 鮮度切れのデータは価格を出さない。ワークフローが壊れた静的サイトが
//      半年前の運賃を配り続ける事故を防ぐための最後の砦。
//   3. 「買える値段」ではなく「実際に検索された運賃の目安」として提示する（免責を常時表示）。

import routesConfig from '../data/fareRoutes.json';

interface Props {
  dest: string;            // 到着地 IATA（例: 'NRT'）
  origins?: string[];      // 出発地 IATA の配列。省略時は設定ファイルの全出発地
  heading?: string | null; // 見出し。null で非表示
}

const { dest, origins, heading = 'Typical return fares by month' } = Astro.props;

// 鮮度の上限。これを超えたデータは価格を伏せる。
const MAX_AGE_DAYS = 14;

interface FareMonth {
  month: string;
  price: number;
  airline: string | null;
  departDate: string | null;
  returnDate: string | null;
  transfers: number | null;
}
interface FareFile {
  origin: string;
  destination: string;
  currency: string;
  fetchedAt: string;
  months: FareMonth[];
}

// src/data/fares/*.json を全部読み込む（ディレクトリが空でも {} が返るだけで壊れない）。
const modules = import.meta.glob<{ default: FareFile }>('../data/fares/*.json', { eager: true });
const allFares: FareFile[] = Object.values(modules).map((m) => m.default);

const originList: string[] =
  origins && origins.length ? origins : routesConfig.origins.map((o) => o.iata);

const labelOf = (iata: string) =>
  routesConfig.origins.find((o) => o.iata === iata)?.label ?? iata;
const destLabel = routesConfig.destinations.find((d) => d.iata === dest)?.label ?? dest;

// 指定路線のデータだけ拾う。順序は originList のとおりに固定する。
const columns = originList
  .map((iata) => allFares.find((f) => f.origin === iata && f.destination === dest))
  .filter((f): f is FareFile => Boolean(f) && f!.months.length > 0);

// 鮮度判定。1つでも古いものがあれば、その列だけでなく表全体を伏せる
// （新旧混在の表は「どの数字が古いのか」が読者に分からず、部分的に古いより誤解が大きい）。
const now = Date.now();
const ages = columns.map((c) => (now - new Date(c.fetchedAt).getTime()) / 86_400_000);
const stale = ages.length > 0 && Math.max(...ages) > MAX_AGE_DAYS;
const hasData = columns.length > 0;

// 行（月）は全列の和集合。歯抜けの月はセルを空にする。
const months = [...new Set(columns.flatMap((c) => c.months.map((m) => m.month)))].sort();

const priceAt = (col: FareFile, month: string) =>
  col.months.find((m) => m.month === month)?.price ?? null;

// 列ごとの最安月（ハイライト用）。
const cheapestOf = (col: FareFile) =>
  col.months.reduce((a, b) => (b.price < a.price ? b : a), col.months[0]);

const currency = columns[0]?.currency ?? 'USD';
const newestFetchedAt = hasData
  ? columns.map((c) => c.fetchedAt).sort().at(-1)!
  : null;

const fmtMonth = (m: string) =>
  new Date(`${m}-01T00:00:00Z`).toLocaleDateString('en-US', {
    month: 'short', year: 'numeric', timeZone: 'UTC',
  });
const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', {
    year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
  });
const fmtPrice = (n: number) => `$${n.toLocaleString('en-US')}`;
---

{hasData && (
  <section class="not-prose my-8 rounded-xl border border-black/10 bg-white p-4 sm:p-5">
    {heading && (
      <h3 class="font-serif text-lg font-bold text-brand-700">
        {heading} &mdash; to {destLabel}
      </h3>
    )}

    {stale ? (
      <p class="mt-3 rounded-lg bg-brand-50 px-3 py-4 text-sm text-ink/70">
        Fare data is being refreshed. Rather than show figures that may be weeks out of date,
        we&rsquo;ve hidden them until the next update.
      </p>
    ) : (
      <>
        <div class="mt-3 overflow-x-auto">
          <table class="w-full min-w-[32rem] border-collapse text-sm">
            <thead>
              <tr class="border-b border-black/10 text-left">
                <th class="py-2 pr-3 font-bold text-ink/70">Month</th>
                {columns.map((c) => (
                  <th class="px-3 py-2 font-bold text-ink/70 whitespace-nowrap">
                    {labelOf(c.origin)}
                    <span class="ml-1 font-normal text-ink/40">({c.origin})</span>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {months.map((m) => (
                <tr class="border-b border-black/5">
                  <th class="py-2 pr-3 text-left font-bold whitespace-nowrap text-ink/70">
                    {fmtMonth(m)}
                  </th>
                  {columns.map((c) => {
                    const p = priceAt(c, m);
                    const isCheapest = p !== null && cheapestOf(c).month === m;
                    return (
                      <td
                        class:list={[
                          'px-3 py-2 tabular-nums whitespace-nowrap',
                          isCheapest ? 'font-bold text-accent-600' : 'text-ink/80',
                        ]}
                      >
                        {p === null ? <span class="text-ink/25">&mdash;</span> : fmtPrice(p)}
                        {isCheapest && <span class="ml-1 text-xs font-bold">low</span>}
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="mt-3 text-xs leading-relaxed text-ink/50">
          Lowest return fares in {currency}, aggregated from real searches on Aviasales and
          last updated {fmtDate(newestFetchedAt!)}.
          <strong class="font-bold"> These are indicative, not live quotes</strong> &mdash; seats at
          these prices may already be gone, and taxes and baggage rules vary by carrier.
          Always confirm the current fare before you book. Highlighted cells are the cheapest month
          on record for that route.
        </p>
      </>
    )}
  </section>
)}
