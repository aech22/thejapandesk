---
// GDPR/UK GDPR 向けのCookie同意バナー。
// 同意があるまで非必須スクリプト（GA・Travelpayouts）を読み込まない＝EU準拠。既定は「非必須は読み込まない」。
//
// 例外はクローラーだけ。ボットは Accept を押せないので、同意ゲートの中に入れると
// Travelpayouts のサイト認証（スクリプトが実際に動いているかの確認）が永久に通らない。
// ボットは自然人ではなく個人データも発生しないため、同意済みとして扱ってスクリプトを読ませる。
import { GA_MEASUREMENT_ID, TRAVELPAYOUTS_SCRIPT } from '../consts';
---
<div
  id="cookie-consent"
  style="display:none"
  class="fixed inset-x-0 bottom-0 z-50 border-t border-black/10 bg-white/95 backdrop-blur"
  role="dialog"
  aria-label="Cookie consent"
>
  <div class="mx-auto flex max-w-5xl flex-col gap-3 px-4 py-3 text-sm text-ink/70 sm:flex-row sm:items-center">
    <p class="flex-1">
      We use cookies for analytics and affiliate links. You can accept or decline non-essential cookies.
      See our <a href="/privacy/" class="font-bold text-accent-600 underline">Privacy Policy</a>.
    </p>
    <div class="flex shrink-0 gap-2">
      <button data-decline type="button" class="rounded-full border border-black/15 px-4 py-1.5 text-xs font-bold text-ink/60 transition hover:bg-black/5">Decline</button>
      <button data-accept type="button" class="rounded-full bg-brand-600 px-4 py-1.5 text-xs font-bold text-white transition hover:bg-brand-700">Accept</button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ gaId: GA_MEASUREMENT_ID, tpSrc: TRAVELPAYOUTS_SCRIPT }}>
  (function () {
    var KEY = 'tjd-consent';

    function loadGA() {
      if (!gaId || window.__gaLoaded) return;
      window.__gaLoaded = true;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', gaId);
    }

    // Travelpayouts（サイト認証＋リンク収益化）。ベンダー提供のローダーそのまま。
    function loadTravelpayouts() {
      if (!tpSrc || window.__tpLoaded) return;
      window.__tpLoaded = true;
      var script = document.createElement('script');
      script.async = 1;
      script.setAttribute('data-cmp-ab', '2');
      script.setAttribute('data-cfasync', 'false');
      script.src = tpSrc;
      document.head.appendChild(script);
    }

    // クローラー判定。ヒットしたら「Accept を押した」のと同じ扱いにする（バナーは出さない）。
    function isCrawler() {
      try {
        if (navigator.webdriver) return true;
        var ua = navigator.userAgent || '';
        return /bot|crawler|crawling|spider|slurp|scrape|headlesschrome|phantomjs|puppeteer|playwright|lighthouse|googlebot|bingpreview|yandex|duckduckbot|baiduspider|facebookexternalhit|embedly|preview|ahrefs|semrush|travelpayouts|emerald/i.test(ua);
      } catch (e) { return false; }
    }

    function acceptAll() {
      loadGA();
      loadTravelpayouts();
    }

    var el = document.getElementById('cookie-consent');

    // ボットは同意済み扱い。ただし GA には送らない（ボット流入で計測が汚れるため）。
    if (isCrawler()) {
      loadTravelpayouts();
      return;
    }

    var choice = null;
    try { choice = localStorage.getItem(KEY); } catch (e) {}
    if (choice === 'accepted') {
      acceptAll();
    } else if (!choice && el) {
      el.style.display = 'block';
    }
    if (el) {
      var accept = el.querySelector('[data-accept]');
      var decline = el.querySelector('[data-decline]');
      if (accept) accept.addEventListener('click', function () {
        try { localStorage.setItem(KEY, 'accepted'); } catch (e) {}
        el.style.display = 'none';
        acceptAll();
      });
      if (decline) decline.addEventListener('click', function () {
        try { localStorage.setItem(KEY, 'declined'); } catch (e) {}
        el.style.display = 'none';
      });
    }
  })();
</script>
