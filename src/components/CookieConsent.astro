---
// Cookie 同意バナー。非必須スクリプト（GA・Travelpayouts）の読み込みを制御する。
//
// 事前同意（opt-in）を必須にするのは UK/EEA/スイスの訪問者だけ。GDPR・UK GDPR・ePrivacy が
// 要求しているのはこの地域であり、ターゲットである US/AU/CA は opt-out 方式で足りる。
// 全訪問者を一律 opt-in にすると、Accept を押さない多数派でアフィリリンクの収益化が働かない。
// 地域判定はタイムゾーン（静的サイトなのでサーバ側で国を見られない）。判定できなければ
// 厳しい側＝同意必須に倒す。
//
// クローラーは常に同意済み扱い。ボットは Accept を押せないので、ゲートの中に入れると
// Travelpayouts のサイト認証（スクリプトが実際に動いているかの確認）が永久に通らない。
// ボットは自然人ではなく個人データも発生しないため、読ませてよい。
import { GA_MEASUREMENT_ID, TRAVELPAYOUTS_SCRIPT } from '../consts';
---
<div
  id="cookie-consent"
  style="display:none"
  class="fixed inset-x-0 bottom-0 z-50 border-t border-black/10 bg-white/95 backdrop-blur"
  role="dialog"
  aria-label="Cookie consent"
>
  <div class="mx-auto flex max-w-5xl flex-col gap-3 px-4 py-3 text-sm text-ink/70 sm:flex-row sm:items-center">
    <p class="flex-1">
      We use cookies for analytics and affiliate links. You can accept or decline non-essential cookies.
      See our <a href="/privacy/" class="font-bold text-accent-600 underline">Privacy Policy</a>.
    </p>
    <div class="flex shrink-0 gap-2">
      <button data-decline type="button" class="rounded-full border border-black/15 px-4 py-1.5 text-xs font-bold text-ink/60 transition hover:bg-black/5">Decline</button>
      <button data-accept type="button" class="rounded-full bg-brand-600 px-4 py-1.5 text-xs font-bold text-white transition hover:bg-brand-700">Accept</button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ gaId: GA_MEASUREMENT_ID, tpSrc: TRAVELPAYOUTS_SCRIPT }}>
  (function () {
    var KEY = 'tjd-consent';

    function loadGA() {
      if (!gaId || window.__gaLoaded) return;
      window.__gaLoaded = true;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', gaId);
    }

    // Travelpayouts（サイト認証＋リンク収益化）。ベンダー提供のローダーそのまま。
    function loadTravelpayouts() {
      if (!tpSrc || window.__tpLoaded) return;
      window.__tpLoaded = true;
      var script = document.createElement('script');
      script.async = 1;
      script.setAttribute('data-cmp-ab', '2');
      script.setAttribute('data-cfasync', 'false');
      script.src = tpSrc;
      document.head.appendChild(script);
    }

    // 事前同意が要る地域か。UK/EEA/スイスのタイムゾーンなら true。
    // Europe/* は EEA 外（Europe/Moscow 等）も拾うが、厳しい側に倒すぶんには無害なので広く取る。
    function needsPriorConsent() {
      try {
        var tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
        if (/^Europe\//i.test(tz)) return true;
        // EEA だが Europe/* に入らないもの（アイスランド・フェロー・スバールバル、
        // ポルトガル/スペインの島嶼部、フランス海外県）
        return /^(Atlantic\/(Reykjavik|Azores|Madeira|Canary|Faroe)|Arctic\/Longyearbyen|Indian\/(Reunion|Mayotte)|America\/(Cayenne|Guadeloupe|Martinique|Miquelon))$/i.test(tz);
      } catch (e) {
        return true; // 判定できなければ同意必須の側に倒す
      }
    }

    // クローラー判定。ヒットしたら「Accept を押した」のと同じ扱いにする（バナーは出さない）。
    function isCrawler() {
      try {
        if (navigator.webdriver) return true;
        var ua = navigator.userAgent || '';
        return /bot|crawler|crawling|spider|slurp|scrape|headlesschrome|phantomjs|puppeteer|playwright|lighthouse|googlebot|bingpreview|yandex|duckduckbot|baiduspider|facebookexternalhit|embedly|preview|ahrefs|semrush|travelpayouts|emerald/i.test(ua);
      } catch (e) { return false; }
    }

    function acceptAll() {
      loadGA();
      loadTravelpayouts();
    }

    var el = document.getElementById('cookie-consent');

    // ボットは同意済み扱い。ただし GA には送らない（ボット流入で計測が汚れるため）。
    if (isCrawler()) {
      loadTravelpayouts();
      return;
    }

    var choice = null;
    try { choice = localStorage.getItem(KEY); } catch (e) {}

    if (choice === 'accepted') {
      acceptAll();
    } else if (choice !== 'declined') {
      // 未選択。UK/EEA/スイスは押されるまで読み込まない。それ以外は読み込んだうえで
      // バナーを出し、Decline を選べるようにする（opt-out）。
      if (!needsPriorConsent()) acceptAll();
      if (el) el.style.display = 'block';
    }

    if (el) {
      var accept = el.querySelector('[data-accept]');
      var decline = el.querySelector('[data-decline]');
      if (accept) accept.addEventListener('click', function () {
        try { localStorage.setItem(KEY, 'accepted'); } catch (e) {}
        el.style.display = 'none';
        acceptAll();
      });
      if (decline) decline.addEventListener('click', function () {
        try { localStorage.setItem(KEY, 'declined'); } catch (e) {}
        el.style.display = 'none';
        // opt-out 地域では既に読み込んでいる場合がある。GA は公式のオプトアウトフラグで
        // 即座に送信を止める。Travelpayouts には同等のスイッチが無いため、次のページ読み込みから停止する。
        if (gaId) window['ga-disable-' + gaId] = true;
      });
    }
  })();
</script>
