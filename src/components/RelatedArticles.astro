---
// Related articles at the end of a post (added 2026-09-06). The point is internal linking:
// no article should be a dead end, and posts on the same topic should point at each other.
import type { CollectionEntry } from 'astro:content';
import { pillarBySlug } from '../data/pillars';

interface Props { articles: CollectionEntry<'articles'>[]; }
const { articles } = Astro.props;
---
{
  articles.length > 0 && (
    <nav class="mt-14 border-t border-black/10 pt-6" aria-label="Related articles">
      <h2 class="font-serif text-xl font-bold text-brand-700">Keep reading</h2>
      <ul class="mt-3 divide-y divide-black/5">
        {articles.map((a) => {
          const pillar = pillarBySlug(a.data.pillar);
          return (
            <li class="py-4">
              <a href={`/${a.data.pillar}/${a.data.slug}/`} class="group block">
                {pillar && (
                  <p class="text-xs font-bold uppercase tracking-wide text-accent-600">{pillar.short}</p>
                )}
                <p class="mt-1 font-serif text-base font-bold leading-snug text-brand-700 group-hover:text-accent-600">
                  {a.data.title}
                </p>
                <p class="mt-1 text-sm leading-relaxed text-ink/55">{a.data.description}</p>
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  )
}
