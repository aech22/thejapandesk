---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
---
<BaseLayout title={`Contact | ${SITE_TITLE}`} description="Get in touch with The Japan Desk." breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Contact', url: '/contact/' }]}>
  <main class="mx-auto max-w-3xl px-4 py-10">
    <article class="prose prose-slate max-w-none prose-headings:font-serif prose-a:text-accent-600">
      <h1>Contact</h1>
      <p>The best way to reach me is by email: <strong>hello@thejapandesk.net</strong>.</p>
      <p>I read every message, and I especially welcome:</p>
      <ul>
        <li><strong>Corrections</strong> — if I got a detail wrong about a product, a ware type, an app, or a travel rule, tell me. Accuracy matters here.</li>
        <li><strong>Requests</strong> — a comparison you wish existed? Let me know.</li>
        <li><strong>Business</strong> — brand or partnership enquiries.</li>
      </ul>
      <p>Please allow a few days for a reply.</p>
    </article>
  </main>
</BaseLayout>
