---
import '../styles/global.css';
import Jsonld from '../components/Jsonld.astro';
import { PILLARS } from '../data/pillars';
import {
  SITE_TITLE, SITE_DESCRIPTION, SITE_LIVE,
  GA_MEASUREMENT_ID, PINTEREST_VERIFY, TWITTER_SITE,
} from '../consts';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  ogType?: string;
  publishedTime?: string;
  modifiedTime?: string;
  breadcrumbs?: { name: string; url: string }[];
}
const {
  title,
  description = SITE_DESCRIPTION,
  noindex = false,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  breadcrumbs,
} = Astro.props;

const site = Astro.site ?? new URL('https://thejapandesk.net');
const canonical = new URL(Astro.url.pathname, site);
const ogImg = new URL('/ogp.png', site).toString();
const year = new Date().getFullYear();
// SITE_LIVE=false の間は全ページ noindex（[VERIFY]下書きを検索に載せない）
const robots = (!SITE_LIVE || noindex) ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';

const orgLd = {
  '@context': 'https://schema.org', '@type': 'Organization',
  name: SITE_TITLE, url: site.toString(), description: SITE_DESCRIPTION,
};
const siteLd = {
  '@context': 'https://schema.org', '@type': 'WebSite',
  name: SITE_TITLE, url: site.toString(), inLanguage: 'en',
};
const breadcrumbLd = breadcrumbs && breadcrumbs.length
  ? {
      '@context': 'https://schema.org', '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((b, i) => ({
        '@type': 'ListItem', position: i + 1, name: b.name,
        item: new URL(b.url, site).toString(),
      })),
    }
  : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {PINTEREST_VERIFY && <meta name="p:domain_verify" content={PINTEREST_VERIFY} />}
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800&family=Lora:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImg} />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    {TWITTER_SITE && <meta name="twitter:site" content={TWITTER_SITE} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImg} />
    <Jsonld data={orgLd} />
    <Jsonld data={siteLd} />
    {breadcrumbLd && <Jsonld data={breadcrumbLd} />}
    {GA_MEASUREMENT_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`} is:inline />
        <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${GA_MEASUREMENT_ID}');`} />
      </>
    )}
  </head>
  <body class="min-h-screen font-sans text-ink antialiased">
    <header class="sticky top-0 z-30 border-b border-black/5 bg-paper/85 backdrop-blur">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-3">
        <a href="/" class="flex shrink-0 items-center gap-2">
          <span class="grid h-8 w-8 place-items-center rounded-lg bg-brand-600 font-black text-white shadow-sm">日</span>
          <span class="text-lg font-black tracking-tight">The Japan Desk<span class="text-accent-500">.</span></span>
        </a>
        <nav class="flex items-center gap-1 overflow-x-auto text-sm font-bold text-ink/60 sm:gap-2">
          {PILLARS.map((p) => (
            <a href={`/${p.slug}/`} class="whitespace-nowrap rounded-full px-3 py-1.5 transition hover:bg-brand-50 hover:text-brand-600">
              {p.short}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <slot />

    <footer class="mt-20 border-t border-black/5 bg-white">
      <div class="mx-auto max-w-5xl px-4 py-8 text-sm text-ink/55">
        <p class="text-base font-black text-ink/75">The Japan Desk<span class="text-accent-500">.</span></p>
        <p class="mt-1">{SITE_DESCRIPTION}</p>
        <nav class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-xs font-bold text-ink/60">
          {PILLARS.map((p) => (
            <a href={`/${p.slug}/`} class="hover:text-brand-600">{p.label}</a>
          ))}
          <a href="/about/" class="hover:text-brand-600">About</a>
          <a href="/affiliate-disclosure/" class="hover:text-brand-600">Affiliate Disclosure</a>
          <a href="/privacy/" class="hover:text-brand-600">Privacy</a>
          <a href="/contact/" class="hover:text-brand-600">Contact</a>
        </nav>
        <p class="mt-4 text-xs leading-relaxed text-ink/45">
          The Japan Desk uses affiliate links. If you buy through them we may earn a commission at no extra cost to you. Reviews are based on specifications, verified customer reviews and Japanese-language sources; where a review is research-based rather than hands-on we say so. Prices and availability change — check the retailer for the latest.
        </p>
        <p class="mt-3 text-xs text-ink/35">© {year} The Japan Desk · Operated by TODGE</p>
      </div>
    </footer>
  </body>
</html>
